# Parra PoC: environment isolation prototype.
#
# Everything Parra-specific lives in this directory so that `gclient sync` and
# upstream rebases do not conflict with it. Injection points into upstream code
# are intentionally tiny; see docs/parra/04-phase1-poc-report.md for the list.

source_set("parra") {
  sources = [
    "environment.cc",
    "environment.h",
    "environment_registry.cc",
    "environment_registry.h",
    "environment_serialization.cc",
    "environment_serialization.h",
    "environment_store.cc",
    "environment_store.h",
    "environment_store_factory.cc",
    "environment_store_factory.h",
    "environment_tab_router.cc",
    "environment_tab_router.h",
    "environment_tag.cc",
    "environment_tag.h",
    "parra_storage_partition_util.cc",
    "parra_storage_partition_util.h",
    "parra_switches.cc",
    "parra_switches.h",
  ]

  # Deliberately free of //chrome/browser/ui dependencies so that lower layers
  # (//chrome/browser/net, //chrome/browser/ui/navigator) can depend on it
  # without creating a GN cycle with //chrome/browser:core.
  #
  # //chrome/browser/profiles:profile already carries profile.h AND
  # profile_keyed_service_factory.h (see chrome/browser/profiles/BUILD.gn:418-433),
  # so the factory needs no new target and introduces no new edge.
  deps = [
    "//base",
    "//chrome/common:constants",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//components/prefs",
    "//content/public/browser",
    "//crypto",
    "//net",
  ]
}

# Phase 2.1: index mapping and visibility switching. Separate from :parra
# because it needs TabStripModel, which pulls in the UI layer.
#
# WindowEnvironmentState lives here rather than in :parra because it is scoped to
# a BrowserWindowInterface, which is a UI-layer type. Putting it in the low layer
# would force :parra to depend on the UI layer and create a GN cycle.
source_set("parra_tabs") {
  sources = [
    "environment_index_mapper.cc",
    "environment_index_mapper.h",
    "environment_tab_operations.cc",
    "environment_tab_operations.h",
    "environment_visibility_controller.cc",
    "environment_visibility_controller.h",
    "window_environment_state.cc",
    "window_environment_state.h",
  ]

  deps = [
    ":parra",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:tab_strip_impl",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base/unowned_user_data",
  ]
}

# Startup glue: opens one tab per configured environment. Depends on the UI
# layer, so only //chrome/browser:core may depend on it.
source_set("parra_startup") {
  sources = [
    "parra_index_mapper_selftest.cc",
    "parra_index_mapper_selftest.h",
    "parra_lifecycle_poc.cc",
    "parra_lifecycle_poc.h",
    "parra_startup.cc",
    "parra_startup.h",
    "parra_tab_ops_selftest.cc",
    "parra_tab_ops_selftest.h",
    "parra_visibility_poc.cc",
    "parra_visibility_poc.h",
  ]

  deps = [
    ":parra",
    ":parra_tabs",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator:navigator",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip_impl",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}
