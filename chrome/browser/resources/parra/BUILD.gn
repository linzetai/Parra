import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "parra"

  # A single static HTML shell. The page is a WebUI, not a polymer app: it has one
  # route, no history, and no per-view documents, so an extra .html.ts would add
  # indirection without a benefit.
  static_files = [ "parra.html" ]

  css_files = [ "parra.css" ]

  ts_files = [
    "host_mapping.ts",
    "parra.ts",
    "parra_api.ts",
    "parra_elements.ts",
  ]

  # The generated mojom bindings, produced by the mojom() target next to parra.mojom.
  # Importing them is what keeps the page and the browser talking the same contract:
  # a field renamed on one side fails the build, not the user's click.
  mojo_files_deps = [
    "//chrome/browser/ui/webui/parra:mojo_bindings_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/chrome/browser/ui/webui/parra/parra.mojom-webui.ts",
  ]

  ts_composite = true

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  # The page edits persistent browser configuration, so it must run only in a trusted
  # context. "untrusted" would put it behind the untrusted-types CSP used for pages
  # that render remote content.
  webui_context_type = "trusted"
}
