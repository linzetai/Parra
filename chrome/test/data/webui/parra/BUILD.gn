import("../build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [ "parra_host_mapping_browsertest.cc" ]
  files = [ "host_mapping_test.ts" ]

  ts_path_mappings = [
    "chrome://parra/*|" + rebase_path(
            "$root_gen_dir/chrome/browser/resources/parra/tsc/*",
            target_gen_dir),
  ]
  ts_deps = [
    "//chrome/browser/resources/parra:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]
}
